FROM pytorch/pytorch:2.12.1-cuda12.6-cudnn9-devel

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV UV_BREAK_SYSTEM_PACKAGES=true

WORKDIR /workspace

COPY . /workspace

RUN set -eux && \
    uv pip install --system -e ".[dev,metrics,deepspeed]" && \
    llamafactory-cli version && \
    pip cache purge && \
    uv cache clean
